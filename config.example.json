{
  "usage_file": "~/.claude/rate-limit.json",
  "log_dir": "~/.cache/claude-usage-clock",
  "display": {
    "show_usage": true,
    "show_time": true
  },
  "statusline": {
    "yellow_from": 50,
    "red_from": 75,
    "week_stop_marker": true,
    "show_reset": true,
    "context_yellow_from_k": 300,
    "context_red_from_k": 500,
    "cache_yellow_below_min": 5
  },
  "thresholds": {
    "start_block_5h": 75,
    "start_block_week": 75,
    "warn": 85,
    "checkpoint_only": 92,
    "deny": 95,
    "max_age_min": 15,
    "calls_without_checkpoint": 15,
    "unknown_usage_max_agents": 1,
    "week_action": "warn",
    "ask_verified_in_bypass": false
  },
  "context_reporter": {
    "after_tool_from": 50,
    "max_age_min": 15
  },
  "wake_watcher": {
    "from_k": 0,
    "lead_min": 10,
    "routine_file": ""
  },
  "history": {
    "enabled": true,
    "heartbeat_min": 15,
    "max_kb": 1024
  },
  "start_estimate": {
    "chars_per_token": 2.3
  },
  "checkpoint_dir_suffix": "/agent-checkpoints",
  "spawn_rules": {
    "model_effort_action": "warn",
    "model_pattern": "sonnet|opus|haiku|fable|inherit|claude-[a-z0-9-]+",
    "effort_values": ["low", "medium", "high", "xhigh", "max"],
    "suggested_agents": [],
    "exceptions": ["claude-code-guide", "statusline-setup"],
    "apply_to_main_session": true,
    "skill_fork_missing_agent": "warn",
    "model_override_in_call": "warn"
  },
  "modules": {
    "desktop_line": "full",
    "usage_clock": true,
    "context_reporter": true,
    "spawn_gate": "",
    "soft_stop": ""
  },
  "sync": {
    "mode": "off",
    "repo": "",
    "transport": "https",
    "machine_name": "",
    "interval_min": 30,
    "backoff_max_h": 6,
    "pull_timeout_s": 5,
    "project_labels": "plain",
    "project_aliases": {},
    "label_salt": "",
    "include_gates": true,
    "keep_request_months": 3,
    "max_clone_mb": 1024
  }
}
